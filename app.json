{
  "expo": {
    "name": "GGC Work",
    "slug": "ggcwork",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1120"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ggclink.ggcwork",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Aplikasi menggunakan lokasi untuk memverifikasi kehadiran absen sesuai area kantor.",
        "NSCameraUsageDescription": "Aplikasi menggunakan kamera untuk mengambil foto selfie saat absen dan verifikasi kehadiran.",
        "NSPhotoLibraryUsageDescription": "Aplikasi membutuhkan akses galeri untuk menyimpan slip gaji dan berbagi dokumen."
      }
    },
    "android": {
      "package": "com.ggclink.ggcwork",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Izinkan GGC Work mengakses lokasi untuk verifikasi absen di area kantor."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan GGC Work mengakses kamera untuk foto selfie saat absen."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563eb"
        }
      ],
      "expo-secure-store",
      "./plugins/removeUnusedPermissions",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "401c38e2-72e5-494b-b241-0fbf1c63a3bf"
      }
    },
    "owner": "santhakills-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/401c38e2-72e5-494b-b241-0fbf1c63a3bf"
    }
  }
}
